# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL connection string — local install (Windows/Mac/Linux) or any hosted Postgres.
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# For a local install on Windows with the default superuser, this is typically:
# postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/school_management_db
# Create the database first (e.g. via pgAdmin, or `createdb school_management_db`
# / `psql -U postgres -c "CREATE DATABASE school_management_db;"`).
# NOTE: keep the "+psycopg2" part — it pins the driver explicitly so a future SQLAlchemy
# upgrade can't silently switch to a different Postgres driver.
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@localhost:5432/school_management_db

# Email (Gmail App Password) — used for verification emails, password resets, notifications
# Generate at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-school-system-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-school-system-email@gmail.com

# App
APP_NAME=School Management System

# Development server binding (optional). Default 127.0.0.1:5000.
# APP_HOST=127.0.0.1
# APP_PORT=5000

# Where uploaded documents are stored (optional). Default: <project>/instance/uploads
# UPLOAD_FOLDER=
